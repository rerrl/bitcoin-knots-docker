# Lightning Fork (BLAKE2b) — lnd and lncli for the Bitcoin BLAKE2b chain.
#
# Built from a pinned git tag of https://github.com/paulscode/lightning-fork and
# from the btcd fork that its go.mod pins, so the image records exactly what it
# runs. To bump, change LND_VERSION below to the newest -blake2b release tag.
FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine AS builder

# Pinned Lightning Fork release tag (git ref that is cloned and checked out).
ENV LND_VERSION=v0.21.8-beta-blake2b.24
ENV LND_URL=https://github.com/paulscode/lightning-fork

ARG TARGETOS
ARG TARGETARCH

# Install dependencies and build the binaries. The module path is upstream's
# (github.com/lightningnetwork/lnd); go.mod replaces btcd with the fork. Go
# installs a cross-compiled binary under a per-platform directory, so it is
# moved to where the final stage looks.
RUN apk add --no-cache --update alpine-sdk \
    git \
    make \
    gcc \
&&  git clone $LND_URL /go/src/github.com/lightningnetwork/lnd \
&&  cd /go/src/github.com/lightningnetwork/lnd \
&&  git checkout $LND_VERSION \
&&  git rev-parse HEAD > /lightning-fork-commit \
&&  go list -m -f '{{.Replace.Path}} {{.Replace.Version}}' github.com/btcsuite/btcd > /btcd-blake2b-version \
&&  GOOS=$TARGETOS GOARCH=$TARGETARCH make release-install \
&&  if [ -d /go/bin/${TARGETOS}_${TARGETARCH} ]; then \
        mv /go/bin/${TARGETOS}_${TARGETARCH}/* /go/bin/; \
    fi

# Runtime stage.
FROM alpine

# Utilities for quality of life and SSL-related reasons, plus the verification
# script's dependencies (wget, gpg).
RUN apk --no-cache add \
    bash \
    bash-completion \
    fish \
    jq \
    ca-certificates \
    gnupg \
    wget

# Host user/group IDs so files in the mounted data dir stay owned by the host
# user (same convention as the other services).
ARG USER_ID=1000
ARG GROUP_ID=1000

# Create the non-root lnd user with matching IDs.
RUN addgroup -g ${GROUP_ID} lnd && \
    adduser -D -u ${USER_ID} -G lnd -h /home/lnd lnd

# Copy the binaries from the builder image and record what this image runs:
# the fork commit and the btcd fork version.
COPY --from=builder /go/bin/lnd /usr/local/bin/
COPY --from=builder /go/bin/lncli /usr/local/bin/
COPY --from=builder /lightning-fork-commit /etc/lightning-fork-commit
COPY --from=builder /btcd-blake2b-version /etc/btcd-blake2b-version

RUN sha256sum /usr/local/bin/lnd /usr/local/bin/lncli > /shasums.txt \
  && cat /shasums.txt

# Official bash completion script from the pinned upstream tag (top-level commands
# and global flags). Alpine's bashrc sources bash-completion for interactive shells.
COPY --from=builder /go/src/github.com/lightningnetwork/lnd/contrib/lncli.bash-completion \
    /usr/share/bash-completion/completions/lncli

# Per-command flag completion with descriptions, generated by lncli's official
# hidden fish-completion command. Fails the build if the output is empty.
RUN mkdir -p /usr/share/fish/vendor_completions.d \
  && lncli fish-completion > /usr/share/fish/vendor_completions.d/lncli.fish \
  && test -s /usr/share/fish/vendor_completions.d/lncli.fish \
  && wc -l /usr/share/fish/vendor_completions.d/lncli.fish

# Data directory (persisted via the ${LND_DATA_PATH} volume). The config lives
# outside it so a mounted data dir cannot hide it; lnd is pointed at it below.
RUN mkdir -p /home/lnd/.lnd && \
    chown -R lnd:lnd /home/lnd

# Copy configuration and entrypoint.
COPY --chown=lnd:lnd lnd/lnd.conf /home/lnd/lnd.conf
COPY --chown=lnd:lnd lnd/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# lnd derives its default lnddir from $HOME.
ENV HOME=/home/lnd

# Switch to the non-root lnd user.
USER lnd
WORKDIR /home/lnd

# Expose ports
# 9735:  P2P
# 10009: gRPC
# 8080:  REST
EXPOSE 9735 10009 8080

# Default data directory
VOLUME ["/home/lnd/.lnd"]

ENTRYPOINT ["/entrypoint.sh"]
CMD ["lnd", "--configfile=/home/lnd/lnd.conf"]
